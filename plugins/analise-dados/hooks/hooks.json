{
  "description": "Regras de casa no início da sessão, checagem de cada célula escrita pelo Jupyter MCP e desligamento do Jupyter ao sair",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--no-project", "--quiet", "${CLAUDE_PLUGIN_ROOT}/scripts/hook_sessao.py"],
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__(plugin_analise-dados_)?jupyter__(insert_cell|insert_execute_code_cell|overwrite_cell_source|edit_cell_source)$",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--no-project", "--quiet", "${CLAUDE_PLUGIN_ROOT}/scripts/hook_celula.py"],
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--no-project", "--quiet", "${CLAUDE_PLUGIN_ROOT}/scripts/stop.py"],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
